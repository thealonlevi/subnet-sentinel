[Unit]
Description=Subnet Sentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/subnet-sentinel
EnvironmentFile=/etc/subnet-sentinel/.env
Environment=SUBNET_SENTINEL_CONFIG=/etc/subnet-sentinel/config.yaml
ExecStart=/usr/local/bin/subnet-sentinel
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
